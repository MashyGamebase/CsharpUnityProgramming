## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Packages
*.nupkg
*.snupkg
# Uncomment the next line if you remove everything in the Packages folder from source control
# !packages/
# excluding the packages folder used by the nuget bootstrapper
.nuget/packages/
.nuget/artifacts/
# excluding the .vs folder
.vs/
# excluding the .vscode folder
.vscode/

# Build results for F# projects
*.fsi
*.mli

# User-specific files for ReSharper
_ReSharper.*/
*.ReSharper
*.dotSettings
*.dotSettings.User
_tf/

# User-specific files for Visual Studio Code
.ionide/

# User-specific files for JetBrains Rider
*.sln.iml

# Microsoft Fakes
FakesAssemblies/

# DotCover
*.dotCover

# NCrunch
*.ncrunch*
*.crunch*

# Visual Studio Performance Profiler
*.psess
*.vsp
*.vspx
*.vspdb

# CodeSmith
*.cst

# DocProject
*.dtproj
*.dtproj.user
*.rd
*.rstore

# AnkhSVN
*.skn

# VsVim
*.vsvimsettings

# MonoDevelop
*.pidb
*.resources

# AnkhSVN
*.atps

# Paket Dependency Manager
.paket/
paket-files/

# FAKE - F# Make
.fake/

# CodeRush
*.crproj

# Python Tools for Visual Studio (PTVS)
__pycache__/
*.pyc

# Node.js Tools for Visual Studio (NTVS)
.ntvs_analysis.dat
node_modules/
obj/

# TypeScript
*.js.map
*.ts.map
*.local.config

# Microsoft Azure
*.azurePubxml
*.publishsettings
*.pubxml

# Developer Command Prompt
*.wsuo

# CLR Profiler Memory Dump
*.vcdump

# ClickOnce
*.application
*.deploy
*.manifest
*.xbap

# StyleCop
StyleCop.Cache

# DotMemory
*.dm

# Profiler
*.sap

# Cake - C# Make
[Tt]ools/
!tools/Addins/

# Emacs
*~
.#*
.loadpath

# Vim
*.swp
*.swo
*.swn
*.swo

# OS X
.DS_Store

# Windows thumbnail cache
Thumbs.db

# User-specific files for local testing/settings
*.local.json
*.user.json
*.secrets.json